# Neon (pulled by `neon deploy` / `neon env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Turso extras (handles, Noun seeds, wallet serials). App runs without these.
# Set with dotenvx: `npx dotenvx set TURSO_AUTH_TOKEN -- -f .env`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# dotenvx on Vercel: set DOTENV_PRIVATE_KEY (+ DOTENV_FILE=.env.production). Never commit .env.keys.

# ERC-4337 on Base. Passkey signs; Pimlico bundles and (optionally) sponsors gas.
NEXT_PUBLIC_PIMLICO_API_KEY=
NEXT_PUBLIC_BUNDLER_URL=
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org

# Self. Deploy a Pre-KYC flow with every Additional data reveal on
# (name, ID number, DOB, gender, nationality, expiry, issuing state).
# Keep the live key in .env.local only.
SELF_API_KEY=
SELF_FLOW_ID=
SELF_WEBHOOK_SECRET=
